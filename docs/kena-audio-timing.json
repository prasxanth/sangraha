      "phrases": [
        {
          "start": 0,
          "end": 6.63,
          "sanskrit": "ॐ",
          "iast": "oṃ",
          "english": "Om."
        },
        {
          "start": 6.63,
          "end": 11.14,
          "sanskrit": "आप्यायन्तु ममाङ्गानि ।",
          "iast": "āpyāyantu mamāṅgāni |",
          "english": "May my limbs flourish."
        },
        {
          "start": 11.14,
          "end": 18.83,
          "sanskrit": "वाक्प्राणश्चक्षुः श्रोत्रमथो बलमिन्द्रियाणि च सर्वाणि ।",
          "iast": "vākprāṇaścakṣuḥ śrotramatho balamindriyāṇi ca sarvāṇi |",
          "english": "May speech, vital breath, eyes, ears, strength and all the senses flourish."
        },
        {
          "start": 18.83,
          "end": 22.65,
          "sanskrit": "सर्वं ब्रह्मौपनिषदम् ।",
          "iast": "sarvaṃ brahmaupaniṣadam |",
          "english": "All is Brahman as taught in the Upaniṣads."
        },
        {
          "start": 22.65,
          "end": 29.65,
          "sanskrit": "माहं ब्रह्म निराकुर्यां मा मा ब्रह्म निराकरोत् ।",
          "iast": "māhaṃ brahma nirākuryāṃ mā mā brahma nirākarot |",
          "english": "May I not deny Brahman; may Brahman not deny me."
        },
        {
          "start": 29.65,
          "end": 35.25,
          "sanskrit": "अनिराकरणमस्त्वनिराकरणं मेऽस्तु ।",
          "iast": "anirākaraṇamastvanirākaraṇaṃ me’stu |",
          "english": "May there be no rejection; may there be no rejection of me."
        },
        {
          "start": 35.25,
          "end": 42.25,
          "sanskrit": "तदात्मनि निरते य उपनिषत्सु धर्मास्ते मयि सन्तु ।",
          "iast": "tadātmani nirate ya upaniṣatsu dharmāste mayi santu |",
          "english": "May the virtues taught in the Upaniṣads dwell in me, who am devoted to the Self."
        },
        {
          "start": 42.25,
          "end": 44.94,
          "sanskrit": "ते मयि सन्तु ।",
          "iast": "te mayi santu |",
          "english": "May they dwell in me."
        },
        {
          "start": 44.94,
          "end": 51.55,
          "sanskrit": "ॐ शान्तिः शान्तिः शान्तिः ॥",
          "iast": "oṃ śāntiḥ śāntiḥ śāntiḥ ||",
          "english": "Om. Peace, peace, peace."
        }
      ]
    },
    {
