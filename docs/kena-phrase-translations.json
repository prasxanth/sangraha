      "english": "Then indeed it still requires inquiry on your part."
    },
    {
      "start": 23,
      "end": 25,
      "sanskrit": "मन्ये विदितम्",
      "iast": "manye viditam",
      "english": "“I think [it is] understood.”"
    }
  ],
  "2.2": [
    {
      "start": 0,
      "end": 5,
      "sanskrit": "न अहम् मन्ये सुवेद इति",
