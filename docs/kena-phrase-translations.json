      "end": 23,
      "sanskrit": "न उ न वेद इति",
      "iast": "na u na veda iti",
      "english": "not indeed “I do not know,”"
    },
    {
      "start": 23,
      "end": 25,
      "sanskrit": "वेद च",
      "iast": "veda ca",
      "english": "and I do know."
    }
  ],
  "2.3": [
    {
      "start": 0,
      "end": 4,
      "sanskrit": "यस्य अमतम् तस्य मतम्",
