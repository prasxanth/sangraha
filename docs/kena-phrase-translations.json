      "english": "That which is not expressed by speech,"
    },
    {
      "start": 3,
      "end": 6,
      "sanskrit": "येन वाक् अभ्युद्यते",
      "iast": "yena vāk abhyudyate",
      "english": "by which speech is expressed—"
    },
    {
      "start": 6,
      "end": 11,
      "sanskrit": "तत् एव ब्रह्म त्वम् विद्धि",
