{
  "1.1": [
    {
      "start": 0,
      "end": 1,
      "sanskrit": "ॐ",
      "iast": "oṃ",
      "english": "Om."
    },
    {
      "start": 1,
      "end": 6,
      "sanskrit": "केन इषितम् पतति प्रेषितम् मनः",
      "iast": "kena iṣitam patati preṣitam manaḥ",
      "english": "By whom impelled does the directed mind go forth?"
    },
    {
      "start": 6,
      "end": 11,
      "sanskrit": "केन प्राणः प्रथमः प्रैति युक्तः",
      "iast": "kena prāṇaḥ prathamaḥ praiti yuktaḥ",
      "english": "By whom engaged does the foremost vital breath proceed?"
    },
    {
      "start": 11,
      "end": 16,
      "sanskrit": "केन इषिताम् वाचम् इमाम् वदन्ति",
      "iast": "kena iṣitām vācam imām vadanti",
      "english": "By whom impelled do people utter this speech?"
    },
    {
      "start": 16,
      "end": 22,
      "sanskrit": "चक्षुः श्रोत्रम् कः उ देवः युनक्ति",
      "iast": "cakṣuḥ śrotram kaḥ u devaḥ yunakti",
      "english": "What shining power indeed directs eye and ear?"
    }
  ],
  "1.2": [
    {
      "start": 0,
      "end": 4,
      "sanskrit": "श्रोत्रस्य श्रोत्रम् मनसः मनः",
      "iast": "śrotrasya śrotram manasaḥ manaḥ",
      "english": "The ear of the ear, the mind of the mind;"
    },
    {
      "start": 4,
      "end": 8,
      "sanskrit": "यत् वाचः ह वाचम्",
      "iast": "yat vācaḥ ha vācam",
      "english": "that which is indeed the speech of speech;"
    },
    {
      "start": 8,
      "end": 12,
      "sanskrit": "सः उ प्राणस्य प्राणः",
      "iast": "saḥ u prāṇasya prāṇaḥ",
      "english": "that indeed is the life of the vital breath,"
    },
    {
      "start": 12,
      "end": 14,
      "sanskrit": "चक्षुषः चक्षुः",
      "iast": "cakṣuṣaḥ cakṣuḥ",
      "english": "the eye of the eye."
    },
    {
      "start": 14,
      "end": 16,
      "sanskrit": "अतिमुच्य धीराः",
      "iast": "atimucya dhīrāḥ",
      "english": "Having freed themselves [from identification with these], the wise,"
    },
    {
      "start": 16,
      "end": 21,
      "sanskrit": "प्रेत्य अस्मात् लोकात् अमृताः भवन्ति",
      "iast": "pretya asmāt lokāt amṛtāḥ bhavanti",
      "english": "departing from this world, become immortal."
    }
  ],
  "1.3": [
    {
      "start": 0,
      "end": 4,
      "sanskrit": "न तत्र चक्षुः गच्छति",
      "iast": "na tatra cakṣuḥ gacchati",
      "english": "The eye does not go there;"
    },
    {
      "start": 4,
      "end": 10,
      "sanskrit": "न वाक् गच्छति न उ मनः",
      "iast": "na vāk gacchati na u manaḥ",
      "english": "speech does not go there, nor indeed the mind."
    },
    {
      "start": 10,
      "end": 17,
      "sanskrit": "न विद्मः न विजानीमः यथा एतत् अनुशिष्यात्",
      "iast": "na vidmaḥ na vijānīmaḥ yathā etat anuśiṣyāt",
      "english": "We do not know, nor understand, how one might teach this."
    },
    {
      "start": 17,
      "end": 21,
      "sanskrit": "अन्यत् एव तत् विदितात्",
      "iast": "anyat eva tat viditāt",
      "english": "It is indeed other than the known,"
    },
    {
      "start": 21,
      "end": 24,
      "sanskrit": "अथो अविदितात् अधि",
      "iast": "atho aviditāt adhi",
      "english": "and beyond the unknown."
    },
    {
      "start": 24,
      "end": 31,
      "sanskrit": "इति शुश्रुम पूर्वेषाम् ये नः तत् व्याचचक्षिरे",
      "iast": "iti śuśruma pūrveṣām ye naḥ tat vyācacakṣire",
      "english": "Thus we have heard from the earlier teachers who explained it to us."
    }
  ],
  "1.4": [
    {
      "start": 0,
      "end": 3,
      "sanskrit": "यत् वाचा अनभ्युदितम्",
